{
  "name": "frontend.rocks",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build-prod": "node -e \"import('node:fs').then(fs => ['.next','out','dist'].forEach(d => fs.rmSync(d, {recursive:true, force:true})))\" && npm run validate:content && npm run generate:exports && next build && mv out dist",
    "maintenance:indexnow-quarantine": "tsx scripts/maintenance/indexnow-quarantine.ts",
    "predev": "tsx scripts/generate-exports.ts --skip-og",
    "generate:exports": "tsx scripts/generate-exports.ts",
    "generate:exports:fast": "tsx scripts/generate-exports.ts --skip-og",
    "build:public-skill": "tsx scripts/build-public-skill-bundle.ts",
    "generate:lab-previews": "tsx scripts/capture-lab-previews.ts",
    "clean": "node -e \"import('node:fs').then(fs => ['.next','out','dist'].forEach(d => fs.rmSync(d, {recursive:true, force:true})))\"",
    "lint": "eslint . --max-warnings=6",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "proof:migrate-evidence": "tsx scripts/proof/migrate-evidence-to-claims.ts",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run validate:content"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.511.0",
    "next": "^16.4.6",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/picomatch": "4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "es-module-lexer": "2.3.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "picomatch": "4.0.7",
    "prettier": "^3.10.1",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "web-features": "^3.47.0",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "overrides": {
    "pkce-challenge": "5.0.1"
  }
}
