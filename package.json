{
  "name": "frontend.rocks",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build-prod": "node -e \"import('node:fs').then(fs => ['.next','out','dist'].forEach(d => fs.rmSync(d, {recursive:true, force:true})))\" && npm run validate:content && npm run proof:build && npm run generate:exports && next build && mv out dist",
    "maintenance:indexnow-quarantine": "tsx scripts/maintenance/indexnow-quarantine.ts",
    "predev": "npm run proof:build && tsx scripts/generate-exports.ts --skip-og",
    "generate:exports": "tsx scripts/generate-exports.ts",
    "generate:exports:fast": "tsx scripts/generate-exports.ts --skip-og",
    "build:redirects": "tsx scripts/build-redirects.ts",
    "build:public-skill": "tsx scripts/build-public-skill-bundle.ts",
    "generate:lab-previews": "tsx scripts/capture-lab-previews.ts",
    "clean": "node -e \"import('node:fs').then(fs => ['.next','out','dist'].forEach(d => fs.rmSync(d, {recursive:true, force:true})))\"",
    "lint": "eslint . --max-warnings=6",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "proof:build": "tsx scripts/proof/build-experiments.ts && tsx scripts/proof/build-vendor.ts && tsx scripts/proof/build-harness.ts",
    "proof:build-lab": "tsx scripts/proof/build-lab-site.ts",
    "proof:lab-dev": "tsx scripts/proof/build-vendor.ts && tsx scripts/proof/build-lab-site.ts --dev && tsx scripts/proof/lab-dev-server.ts",
    "proof:run": "npm run proof:build && tsx scripts/proof/run-experiments.ts",
    "proof:aggregate": "tsx scripts/proof/aggregate-results.ts",
    "proof:gate": "tsx scripts/proof/gate.ts",
    "proof:selftest": "npm run proof:build && tsx scripts/proof/selftest.ts",
    "proof:all": "tsx scripts/proof/all.ts",
    "proof:migrate-evidence": "tsx scripts/proof/migrate-evidence-to-claims.ts",
    "proof:verify-specs": "tsx scripts/proof/verify-spec-quotes.ts",
    "proof:verify-sources": "tsx scripts/proof/verify-source-quotes.ts",
    "proof:support": "tsx scripts/proof/check-support.ts",
    "proof:coverage": "tsx scripts/proof/check-coverage.ts",
    "proof:nightly": "tsx scripts/proof/nightly.ts --out artifacts/proof-nightly",
    "proof:nightly-health": "tsx scripts/proof/nightly-health.ts",
    "design:tokens": "tsx scripts/design/build-tokens.ts",
    "design:tokens:check": "tsx scripts/design/build-tokens.ts --check",
    "design:contrast": "tsx scripts/design/check-contrast.ts",
    "design:snapshots": "tsx scripts/design/capture-snapshots.ts",
    "design:snapshots:check": "tsx scripts/design/capture-snapshots.ts --check",
    "design:assign-pieces": "tsx scripts/design/assign-piece-colors.ts",
    "visual:update": "node -e \"const {execSync}=require('node:child_process');const v=require('./package.json').devDependencies['@playwright/test'].replace(/^[^0-9]*/,'');execSync('docker run --rm --ipc=host -v \\\"'+process.cwd()+'\\\":/work -v /work/node_modules -v /work/.next -v /work/dist -w /work mcr.microsoft.com/playwright:v'+v+'-noble bash -lc \\\"npm ci && npm run build-prod && npx playwright test --project=visual --update-snapshots\\\"',{stdio:'inherit'});\"",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run validate:content && npm run design:tokens:check && npm run design:contrast && npm run design:snapshots:check"
  },
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.9",
    "@codemirror/lang-javascript": "6.2.3",
    "@codemirror/language": "6.11.0",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "@fontsource/dseg7-classic": "5.3.0",
    "@mdn/browser-compat-data": "8.1.8",
    "@mdx-js/mdx": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "1.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.511.0",
    "mdast-util-to-string": "4.0.0",
    "next": "^16.4.6",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "shiki": "^4.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "web-features": "3.47.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/culori": "4.0.1",
    "@types/node": "^24.0.0",
    "@types/picomatch": "4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "acorn": "8.19.0",
    "culori": "4.0.2",
    "es-module-lexer": "2.3.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-scope": "8.4.0",
    "html-validate": "11.22.1",
    "jsdom": "^31.0.1",
    "picomatch": "4.0.7",
    "prettier": "^3.10.1",
    "satori": "^0.63.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "overrides": {
    "pkce-challenge": "5.0.1"
  }
}
