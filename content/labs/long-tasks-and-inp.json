{
  "type": "constraint-simulator",
  "id": "long-tasks-and-inp",
  "title": "INP Latency Budget: Input Delay + Processing + Presentation",
  "description": "Adjust background task duration, handler work, and DOM nodes to see when INP crosses the 200ms threshold.",
  "presetMode": "long-task-inp",
  "controls": [
    {
      "key": "backgroundTaskMs",
      "label": "Active main-thread task (ms)",
      "kind": "range",
      "min": 10,
      "max": 300,
      "step": 10,
      "defaultValue": 120,
      "unit": "ms"
    },
    {
      "key": "handlerMs",
      "label": "Click handler duration (ms)",
      "kind": "range",
      "min": 5,
      "max": 200,
      "step": 5,
      "defaultValue": 45,
      "unit": "ms"
    },
    {
      "key": "yieldEnabled",
      "label": "Chunk work with scheduler.yield()",
      "kind": "toggle",
      "defaultValue": false
    }
  ]
}
