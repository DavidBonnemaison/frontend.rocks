{
  "type": "constraint-simulator",
  "id": "js-memory-leaks-retainers",
  "title": "Closure & Detached DOM Retainer Pressure",
  "description": "Simulate heap retention when uncleaned listeners and shared closure contexts pin detached nodes.",
  "presetMode": "memory-retainers",
  "controls": [
    {
      "key": "leakedListeners",
      "label": "Uncleaned global listeners",
      "kind": "range",
      "min": 0,
      "max": 50,
      "step": 5,
      "defaultValue": 10
    },
    {
      "key": "sharedContext",
      "label": "Shared closure captures large buffer",
      "kind": "toggle",
      "defaultValue": true
    },
    {
      "key": "useWeakMap",
      "label": "Use WeakMap for node metadata",
      "kind": "toggle",
      "defaultValue": false
    }
  ]
}
