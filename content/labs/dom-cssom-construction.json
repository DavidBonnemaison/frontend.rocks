        },
        {
          "id": "js",
          "label": "Sync Script",
          "status": "idle"
        }
      ]
    },
    {
      "label": "3. CSSOM Completes, Script Runs",
      "description": "CSSOM finishes building its rule tree; the synchronous script executes and unblocks HTML tokenization.",
