{
  "type": "constraint-simulator",
  "id": "browser-top-layer",
  "title": "Stacking Context Clipping vs Top Layer Promotion",
  "description": "Toggle parent transform/overflow clipping against Top Layer promotion to observe z-index isolation.",
  "presetMode": "stacking-context",
  "controls": [
    {
      "key": "opacity",
      "label": "Parent opacity",
      "kind": "range",
      "min": 0.5,
      "max": 1,
      "step": 0.1,
      "defaultValue": 0.9
    },
    {
      "key": "transform",
      "label": "Parent has transform / overflow: hidden",
      "kind": "toggle",
      "defaultValue": true
    },
    {
      "key": "zIndex",
      "label": "Overlay z-index (ignored in Top Layer)",
      "kind": "range",
      "min": 1,
      "max": 9999,
      "step": 100,
      "defaultValue": 9999
    }
  ]
}
